# Baahar — environment template
#
# Copy to `.env` and fill in what you have. NOTHING here is required for the
# offline demo: Baahar ships recorded fixtures under `data/samples/` and a
# documented heuristic scorer, so a judge with zero keys still gets a real
# run. See docs/NEEDS_HUMAN.md for which steps are human-only.
#
# NEVER commit a filled-in .env. It is gitignored.

# ---------------------------------------------------------------------------
# Google AI Studio — Gemma / Gemini. https://aistudio.google.com/apikey
# Free tier, no credit card. Used for the "Gemma" partner category.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
# Open-weight Gemma, served by Google AI Studio. Model ids verified against a
# live `GET /v1beta/models` listing on 2026-10-06. Older pins like
# `gemma-2.5-9b-it` now return 404, so override these only if you have checked
# the list yourself.
GEMMA_MODEL=gemma-4-31b-it
# Used automatically if the pinned model is retired or unavailable.
GEMMA_MODEL_FALLBACK=gemma-4-26b-a4b-it

# ---------------------------------------------------------------------------
# Tinker — hosted LoRA fine-tuning. https://tinker.ai
# Partner category. Claims credits at https://hacktoberfest.com/my/promos
# Fine-tuning happens HOSTED, so no multi-GB weights ever touch this laptop.
# ---------------------------------------------------------------------------
TINKER_API_KEY=
# Optional: reuse a Tinker training + sampling loop from a previous job.
TINKER_TRAINING_LOOP_NAME=
# Optional: path to a previously exported LoRA for the A/B in eval/RESULTS.md.
TINKER_LORA_PATH=

# ---------------------------------------------------------------------------
# TabPFN — hosted Prior Labs API (optional alternative to the local `ml` extra).
# https://priorlabs.ai  |  https://docs.priorlabs.ai/quickstart
# ---------------------------------------------------------------------------
TABPFN_API_KEY=
TABPFN_BASE_URL=https://api.priorlabs.ai

# ---------------------------------------------------------------------------
# ElevenLabs — optional voice briefing (the Pocket Mode payoff).
# https://elevenlabs.io  |  promo credits at hacktoberfest.com/my/promos
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# ---------------------------------------------------------------------------
# WAQI — optional live Bengaluru station readings to blend with the forecast.
# Free token: https://aqicn.org/data-platform/token/
# ---------------------------------------------------------------------------
WAQI_TOKEN=

# ---------------------------------------------------------------------------
# Local app settings
# ---------------------------------------------------------------------------
BAAHAR_CITY=Bengaluru
BAAHAR_LAT=12.9716
BAAHAR_LON=77.5946
# Set to 1 to force recorded fixtures even when the network is up. Used by CI.
BAAHAR_OFFLINE=0
# Walk duration offered by Pocket Mode, in minutes.
BAAHAR_WALK_MINUTES=20
# HTTP timeout for every outbound call, seconds.
BAAHAR_HTTP_TIMEOUT=12
# Cache successful model-generated briefings (keyed on rounded conditions).
# Set to 0 to disable, e.g. when measuring cold-start latency for the eval.
BAAHAR_CACHE=1