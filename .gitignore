# --- secrets -----------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# --- python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
build/
dist/
*.egg-info/
.eggs/

# --- ml / model artifacts (never commit weights) -----------------------------
models/
*.ckpt
*.pt
*.pth
*.safetensors
*.gguf
tabpfn_cache/
.torch/

# Fitted TabPFN classifiers. Measured 2026-10-06: 840 MB for the gono model, so
# committing one would break the repo for every judge and blow the disk budget in
# AGENTS.md. Recreate it with `uv run python scripts/run_eval.py`, which is the
# only thing that writes it in the first place.
eval/artifacts/
*.pkl

# --- eval raw output ---------------------------------------------------------
# Raw run logs ARE committed (eval/raw/*.json) because RESULTS.md must be
# reproducible. Cached API responses under data/cache/ are NOT.
data/cache/
.tmp/

# --- the walk journal --------------------------------------------------------
# `data/journal.jsonl` is *your* observations, not fixtures. It is the one file in
# this repo that must never be committed by accident: a stray `uv run baahar
# journal` from testing would otherwise publish half-finished field-test entries
# alongside the empty form in docs/FIELD_TEST.md, and the two would contradict
# each other.
#
# Fill-in fields from a *completed* walk are pasted into docs/FIELD_TEST.md by
# hand, deliberately, so the decision to publish an observation stays a human one.
data/journal.jsonl

# --- tooling -----------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.pyre/
.ipynb_checkpoints/
.cache/
.coverage
coverage.xml
htmlcov/
uv.lock.bak
*.tmp
*.temp
*.bak
*.orig

# local `baahar serve` logs
.server.log
.server.err
.server*.err
loop_*.err
loop_*.out
nohup.out
*.log
!docs/**/*.log
!eval/raw/**/*.log

