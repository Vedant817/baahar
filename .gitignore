# --- secrets -----------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# --- python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
build/
dist/
*.egg-info/
.eggs/

# --- ml / model artifacts (never commit weights) -----------------------------
models/
*.ckpt
*.pt
*.pth
*.safetensors
*.gguf
tabpfn_cache/
.torch/

# Fitted TabPFN classifiers. Measured 2026-10-06: 840 MB for the gono model, so
# committing one would break the repo for every judge and blow the disk budget in
# AGENTS.md. Recreate it with `uv run python scripts/run_eval.py`, which is the
# only thing that writes it in the first place.
eval/artifacts/
*.pkl

# --- eval raw output ---------------------------------------------------------
# Raw run logs ARE committed (eval/raw/*.json) because RESULTS.md must be
# reproducible. Cached API responses under data/cache/ are NOT.
data/cache/
.tmp/

# --- tooling -----------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
uv.lock.bak

# local `baahar serve` logs
.server.log
.server.err
*.log
!docs/**/*.log

# --- editors / os ------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# --- human-only artefacts ----------------------------------------------------
# Field-test photos/voice notes are added by the human walk; keep them small
# and deliberate rather than blindly ignored.
docs/field-media/*.mov